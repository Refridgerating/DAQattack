{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.invalid/schemas/v1/processing-recipe.schema.json",
  "title": "LabDAQ processing recipe version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_id", "recipe_version", "name", "status", "execution_class", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "recipe_id": {"$ref": "#/$defs/id"},
    "recipe_version": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active"]},
    "execution_class": {"enum": ["unqualified", "causal"]},
    "initialization_policy": {"type": ["string", "null"], "enum": ["first_sample_steady_state", null]},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "metrics": {"anyOf": [{"$ref": "#/$defs/metrics"}, {"type": "null"}]},
    "fft": {"anyOf": [{"$ref": "#/$defs/fft"}, {"type": "null"}]},
    "psd": {"anyOf": [{"$ref": "#/$defs/psd"}, {"type": "null"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "role": {"enum": ["accelerometer_x", "accelerometer_y", "accelerometer_z", "conditioned_charge"]},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "kind", "applies_to", "causal", "order", "cutoff_hz"],
      "properties": {
        "stage_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["affine_calibration", "butterworth_high_pass", "butterworth_low_pass"]},
        "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
        "causal": {"type": "boolean"},
        "order": {"type": ["integer", "null"], "minimum": 1},
        "cutoff_hz": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["source_stage", "clipping_margin_v"],
      "properties": {"source_stage": {"const": "conditioned"}, "clipping_margin_v": {"type": "number", "minimum": 0}}
    },
    "fft": {
      "type": "object", "additionalProperties": false,
      "required": ["source_stage", "detrend", "window", "normalization", "maximum_samples_per_channel"],
      "properties": {
        "source_stage": {"const": "conditioned"}, "detrend": {"const": "mean"}, "window": {"const": "hann-periodic"},
        "normalization": {"const": "coherent-gain-one-sided-amplitude"},
        "maximum_samples_per_channel": {"type": "integer", "minimum": 2}
      }
    },
    "psd": {
      "type": "object", "additionalProperties": false,
      "required": ["source_stage", "segment_duration_seconds", "overlap_fraction", "detrend", "window", "scaling"],
      "properties": {
        "source_stage": {"const": "conditioned"}, "segment_duration_seconds": {"const": 1.0}, "overlap_fraction": {"const": 0.5},
        "detrend": {"const": "constant"}, "window": {"const": "hann-periodic"}, "scaling": {"const": "density"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {
        "required": ["initialization_policy", "metrics", "fft", "psd"],
        "properties": {"execution_class": {"const": "causal"}, "stages": {"minItems": 2}}
      }
    }
  ]
}
