{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.local/schemas/v1/export-sidecar.schema.json",
  "title": "LabDAQ export metadata sidecar v1",
  "type": "object",
  "required": ["schema_version", "artifact_id", "export_job_id", "source_session_id", "source_session_path", "source_manifest_path", "source_manifest_sha256", "source_raw_digest", "source_schema_version", "source_application_version", "application_version", "export_service_version", "representation", "product", "request", "selected_channels", "channels", "sample_range", "source_sample_count", "recipe_id", "recipe_hash", "recipe", "spectral_details", "decimation", "output_filename", "output_point_counts", "output_byte_count", "output_sha256", "created_at", "timezone", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "export_job_id": {"type": "string", "minLength": 1},
    "source_session_id": {"type": "string", "minLength": 1},
    "source_session_path": {"type": "string", "minLength": 1},
    "source_manifest_path": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_raw_digest": {"$ref": "#/$defs/sha256"},
    "source_schema_version": {"type": "integer", "minimum": 1},
    "source_application_version": {"type": "string", "minLength": 1},
    "application_version": {"type": "string", "minLength": 1},
    "export_service_version": {"type": "string", "minLength": 1},
    "representation": {"enum": ["raw", "calibrated", "filtered", "fft", "psd"]},
    "product": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "selected_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["logical_channel_id", "physical_channel", "sensor_id", "sensor_model", "sensor_serial_number", "label", "raw_unit", "x_unit", "y_unit", "calibration_id", "calibration_hash", "calibration_source", "calibration_quality", "calibration_sensitivity_v_per_output_unit", "calibration_input_offset_v", "calibration_polarity_multiplier", "calibration_effective_date", "processing_disposition", "engineering_interpretation", "warning"],
        "properties": {
          "logical_channel_id": {"type": "string", "minLength": 1},
          "physical_channel": {"type": "string", "minLength": 1},
          "sensor_id": {"type": ["string", "null"]},
          "sensor_model": {"type": ["string", "null"]},
          "sensor_serial_number": {"type": ["string", "null"]},
          "label": {"type": "string", "minLength": 1},
          "raw_unit": {"type": "string", "minLength": 1},
          "x_unit": {"type": "string", "minLength": 1},
          "y_unit": {"type": "string", "minLength": 1},
          "calibration_id": {"type": ["string", "null"]},
          "calibration_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "calibration_source": {"type": ["string", "null"]},
          "calibration_quality": {"type": ["string", "null"]},
          "calibration_sensitivity_v_per_output_unit": {"type": ["number", "null"]},
          "calibration_input_offset_v": {"type": ["number", "null"]},
          "calibration_polarity_multiplier": {"type": ["integer", "null"]},
          "calibration_effective_date": {"type": ["string", "null"], "format": "date"}
          ,"processing_disposition": {"enum": ["calibrated", "raw_only_diagnostic"]}
          ,"engineering_interpretation": {"type": ["string", "null"]}
          ,"spectral_input_stage": {"enum": ["raw", "calibrated", "conditioned", null]}
          ,"warning": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "sample_range": {"type": "object"},
    "source_sample_count": {"type": "integer", "minimum": 1},
    "recipe_id": {"type": ["string", "null"]},
    "recipe_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "recipe": {"type": "object"},
    "spectral_details": {"type": "object"},
    "decimation": {
      "type": "object",
      "required": ["applied", "algorithm"],
      "properties": {
        "applied": {"type": "boolean"},
        "algorithm": {"enum": ["min-max-v1", null]}
      },
      "additionalProperties": false
    },
    "output_filename": {"type": "string", "minLength": 1},
    "output_point_counts": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "output_byte_count": {"type": "integer", "minimum": 0},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "UTC"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "figure": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
