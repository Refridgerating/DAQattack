{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.invalid/schemas/v1/calibration-record.schema.json",
  "title": "Resolved LabDAQ channel calibration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "calibration_id", "calibration_hash", "logical_channel_id",
    "channel_role", "sensor_id", "sensor_model", "sensor_serial_number", "input_unit",
    "output_unit", "sensitivity_v_per_output_unit", "input_offset_v", "polarity_multiplier",
    "quality", "source_kind", "source_reference", "effective_date"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "calibration_id": {"type": "string"},
    "calibration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_channel_id": {"type": "string"},
    "channel_role": {"type": "string"},
    "sensor_id": {"type": "string"},
    "sensor_model": {"type": "string"},
    "sensor_serial_number": {"type": "string"},
    "input_unit": {"const": "V"},
    "output_unit": {"type": "string"},
    "sensitivity_v_per_output_unit": {"type": "number", "exclusiveMinimum": 0},
    "input_offset_v": {"type": "number"},
    "polarity_multiplier": {"enum": [-1, 1]},
    "valid_input_min_v": {"type": ["number", "null"]},
    "valid_input_max_v": {"type": ["number", "null"]},
    "valid_output_min": {"type": ["number", "null"]},
    "valid_output_max": {"type": ["number", "null"]},
    "validated_frequency_min_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "validated_frequency_max_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "extended_frequency_min_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "extended_frequency_max_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "uncertainty": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "quality": {"enum": ["traceable", "nominal", "externally_validated", "synthetic", "unverified"]},
    "source_kind": {"type": "string"},
    "source_reference": {"type": "string"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "expiration_date": {"type": ["string", "null"], "format": "date"},
    "certificate_identifier": {"type": ["string", "null"]},
    "conditions": {"type": ["string", "null"]},
    "transcription_timestamp": {"type": ["string", "null"], "format": "date-time"}
  }
}
