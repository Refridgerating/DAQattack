{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.local/schemas/v1/qualification-report.schema.json",
  "title": "LabDAQ qualification report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "lifecycle", "created_at", "updated_at",
    "operator", "application_version", "operating_system", "plan_id", "plan_hash",
    "hardware_profile_id", "hardware_profile_revision", "hardware_profile_hash",
    "experiment_config_hash", "qualification_fingerprint", "fingerprint_input",
    "hardware_identity", "results", "overall_status", "blocking_reason_codes",
    "warning_reason_codes", "skipped_test_ids", "recommended_actions", "sample_counts",
    "telemetry", "evidence", "session_relative_path", "override", "recovered_from_checkpoint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["in-progress", "completed", "cancelled", "faulted", "recovered"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "operator": {"type": "string"},
    "application_version": {"type": "string"},
    "operating_system": {"type": "string"},
    "plan_id": {"type": "string"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "hardware_profile_id": {"type": "string"},
    "hardware_profile_revision": {"type": "integer"},
    "hardware_profile_hash": {"$ref": "#/$defs/hash"},
    "experiment_config_hash": {"$ref": "#/$defs/hash"},
    "qualification_fingerprint": {"$ref": "#/$defs/hash"},
    "fingerprint_input": {"type": "object"},
    "hardware_identity": {"type": "object"},
    "results": {"type": "array", "items": {"type": "object"}},
    "overall_status": {"enum": ["pass", "fail", "warning", "not-tested"]},
    "blocking_reason_codes": {"type": "array", "items": {"type": "string"}},
    "warning_reason_codes": {"type": "array", "items": {"type": "string"}},
    "skipped_test_ids": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {"type": "array", "items": {"type": "string"}},
    "sample_counts": {"type": "object"},
    "telemetry": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "session_relative_path": {"type": "string"},
    "override": {"type": ["object", "null"]},
    "recovered_from_checkpoint": {"type": "boolean"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
