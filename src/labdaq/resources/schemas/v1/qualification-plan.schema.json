{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.local/schemas/v1/qualification-plan.schema.json",
  "title": "LabDAQ qualification plan version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "plan_revision", "hardware_profile_id",
    "hardware_profile_revision", "experiment_config_hash", "tests",
    "acquisition_rate_hz", "powered_idle_duration_seconds",
    "assisted_window_duration_seconds", "throughput_duration_seconds",
    "maximum_report_age_seconds", "evidence_retention"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "hardware_profile_id": {"type": ["string", "null"]},
    "hardware_profile_revision": {"type": ["integer", "null"], "minimum": 1},
    "experiment_config_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "tests": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/test"}
    },
    "acquisition_rate_hz": {"type": "number", "exclusiveMinimum": 0},
    "powered_idle_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "assisted_window_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "throughput_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "maximum_report_age_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "assisted_settling_duration_seconds": {"type": "number", "minimum": 0},
    "evidence_retention": {"const": "retain-raw"}
  },
  "$defs": {
    "limit": {
      "type": "object", "additionalProperties": false,
      "required": ["limit_id", "comparison", "value", "unit", "signal_stage", "source_category", "source_reference", "rationale", "consequence"],
      "properties": {
        "limit_id": {"type": "string", "minLength": 1},
        "comparison": {"enum": ["lt", "lte", "gt", "gte", "eq", "neq", "between-inclusive"]},
        "value": {"type": ["number", "boolean", "string", "array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "unit": {"type": "string", "minLength": 1},
        "signal_stage": {"enum": ["raw", "calibrated", "conditioned", "acquisition"]},
        "source_category": {"enum": ["manufacturer-specification", "calibration-certificate", "laboratory-baseline", "engineering-policy", "external-validation", "unresolved"]},
        "source_reference": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "consequence": {"enum": ["fail", "warning", "not-tested"]}
        ,"metric_name": {"type": ["string", "null"]}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["test_id", "version", "display_name", "purpose", "required", "classification", "execution_mode", "required_inputs", "prerequisites", "declared_metrics", "limits", "required_confirmation_ids", "advisory_reason_codes"],
      "properties": {
        "test_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "display_name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "classification": {"enum": ["blocking", "advisory"]},
        "execution_mode": {"enum": ["automated", "operator-assisted", "external-fixture"]},
        "required_inputs": {"type": "array", "items": {"type": "string"}},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "declared_metrics": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "array", "items": {"$ref": "#/$defs/limit"}},
        "required_confirmation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "advisory_reason_codes": {"type": "array", "items": {"type": "string", "pattern": "^DAQ\\.QUALIFICATION\\.[A-Z][A-Z0-9_]*$"}, "uniqueItems": true}
      }
    }
  }
}
