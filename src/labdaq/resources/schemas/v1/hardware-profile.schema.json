{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.invalid/schemas/v1/hardware-profile.schema.json",
  "title": "LabDAQ hardware profile version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hardware_profile_id",
    "profile_revision",
    "devices",
    "modules",
    "supported_physical_channels",
    "required_terminal_configuration",
    "input_min_v",
    "input_max_v",
    "application_supported_sample_rates_hz",
    "supported_trigger_modes",
    "minimum_channel_count",
    "maximum_channel_count",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "hardware_profile_id": {"$ref": "#/$defs/id"},
    "profile_revision": {"type": "integer", "minimum": 1},
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/device"}
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    },
    "supported_physical_channels": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/physical_channel"}
    },
    "required_terminal_configuration": {"const": "differential"},
    "input_min_v": {"type": "number"},
    "input_max_v": {"type": "number"},
    "application_supported_sample_rates_hz": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "supported_trigger_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["immediate", "digital_edge"]}
    },
    "minimum_channel_count": {"type": "integer", "minimum": 1},
    "maximum_channel_count": {"type": "integer", "minimum": 1},
    "notes": {"type": ["string", "null"]},
    "nominal_calibration_fallback": {
      "anyOf": [{"$ref": "#/$defs/nominal_calibration_fallback"}, {"type": "null"}]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "nullable_string": {"type": ["string", "null"]},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "vendor",
        "model",
        "role",
        "required",
        "expected_serial_number",
        "alias"
      ],
      "properties": {
        "device_id": {"$ref": "#/$defs/id"},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "expected_serial_number": {"$ref": "#/$defs/nullable_string"},
        "alias": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "device_id",
        "vendor",
        "model",
        "logical_slot",
        "required",
        "channel_count",
        "expected_serial_number"
      ],
      "properties": {
        "module_id": {"$ref": "#/$defs/id"},
        "device_id": {"$ref": "#/$defs/id"},
        "vendor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "logical_slot": {"type": "integer", "minimum": 0},
        "required": {"type": "boolean"},
        "channel_count": {"type": "integer", "minimum": 1},
        "expected_serial_number": {"$ref": "#/$defs/nullable_string"}
      }
    },
    "physical_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "channel_index", "terminal_configuration"],
      "properties": {
        "module_id": {"$ref": "#/$defs/id"},
        "channel_index": {"type": "integer", "minimum": 0},
        "terminal_configuration": {"const": "differential"}
      }
    },
    "nominal_calibration_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_model", "sensitivity_value", "sensitivity_unit", "permitted_channel_roles"],
      "properties": {
        "sensor_model": {"type": "string", "minLength": 1},
        "sensitivity_value": {"type": "number", "exclusiveMinimum": 0},
        "sensitivity_unit": {"enum": ["V/g", "mV/g"]},
        "permitted_channel_roles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["accelerometer_x", "accelerometer_y", "accelerometer_z"]}
        }
      }
    }
  }
}
