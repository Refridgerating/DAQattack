{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labdaq.local/schemas/v1/export-manifest.schema.json",
  "title": "LabDAQ export manifest v1",
  "type": "object",
  "required": ["schema_version", "export_job_id", "source_session_id", "source_manifest_sha256", "application_version", "export_service_version", "requests", "artifacts", "warnings", "faults", "created_at", "completed_at", "final_state", "progress", "manifest_path"],
  "properties": {
    "schema_version": {"const": 1},
    "export_job_id": {"type": "string", "minLength": 1},
    "source_session_id": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "application_version": {"type": "string", "minLength": 1},
    "export_service_version": {"type": "string", "minLength": 1},
    "requests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "export_job_id", "source_session_id", "product", "format", "relative_path", "byte_count", "sha256", "sidecar_relative_path", "sidecar_sha256", "channel_ids", "sample_range", "representation", "units", "recipe_id", "recipe_hash", "calibration_hashes", "warnings", "created_at", "state"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "export_job_id": {"type": "string", "minLength": 1},
          "source_session_id": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "format": {"enum": ["csv", "png", "svg"]},
          "relative_path": {"type": "string", "minLength": 1},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "sidecar_relative_path": {"type": "string", "minLength": 1},
          "sidecar_sha256": {"$ref": "#/$defs/sha256"},
          "channel_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sample_range": {"type": "object"},
          "representation": {"enum": ["raw", "calibrated", "filtered", "fft", "psd"]},
          "units": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "recipe_id": {"type": ["string", "null"]},
          "recipe_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
          "calibration_hashes": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "created_at": {"type": "string", "format": "date-time"},
          "state": {"const": "completed"}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "context"],
        "properties": {
          "code": {"type": "string", "pattern": "^DAQ\\."},
          "message": {"type": "string", "minLength": 1},
          "context": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "final_state": {"enum": ["completed", "cancelled", "faulted"]},
    "progress": {
      "type": "object",
      "required": ["processed_samples", "total_samples", "completed_artifacts", "total_artifacts"],
      "properties": {
        "processed_samples": {"type": "integer", "minimum": 0},
        "total_samples": {"type": "integer", "minimum": 1},
        "completed_artifacts": {"type": "integer", "minimum": 0},
        "total_artifacts": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "manifest_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
